{
  "name": "historia-cli",
  "version": "1.0.44",
  "description": "Maintenance CLI for Historia VTT module",
  "type": "module",
  "main": "src/cli.mjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node src/cli.mjs",
    "organize": "node scripts/organize_folders.mjs",
    "build:it": "node scripts/build_it.mjs",
    "build:en": "node scripts/build_en.mjs",
    "build:all": "npm run build:it && npm run build:en",
    "check:glossario": "node scripts/check-glossario.mjs",
    "check:markup": "node scripts/check-markup.mjs",
    "check:manuale": "node scripts/check-manuale.mjs",
    "check:it": "node scripts/check-markup.mjs && node scripts/check-manuale.mjs && node scripts/check-glossario.mjs --solo-errori"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.3",
    "vitest": "^1.4.0"
  }
}
